#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

CXX_OVERRIDE=${CXX-}
CXXFLAGS_OVERRIDE=${CXXFLAGS-}
RAZC_OVERRIDE=${RAZC-}
if [ -f "$ROOT/options" ]; then . "$ROOT/options"; fi
if [ -f "$ROOT/raz.env" ]; then . "$ROOT/raz.env"; fi
CXX=${CXX_OVERRIDE:-${CXX:-g++}}
CXXFLAGS=${CXXFLAGS_OVERRIDE:-${CXXFLAGS:--O2 -pipe -static -s -DNDEBUG -ffunction-sections -fdata-sections -Wl,--gc-sections}}
RAZC=${RAZC_OVERRIDE:-${RAZC:-"$ROOT/compiler/razc/bin/razc"}}
export RAZC

rm -f tests/run-tests.cpp tests/run-tests.out.tmp
"$RAZC" tests/run-tests.raz --emit-cpp tests/run-tests.cpp
set -f
"$CXX" -std=c++17 $CXXFLAGS -I "$ROOT/library/raz" -I "$ROOT/tests" tests/run-tests.cpp -o tests/run-tests.out.tmp
set +f
mv tests/run-tests.out.tmp tests/run-tests.out
printf 'Built tests/run-tests.out (GNU C++, static flags from options)\n'
