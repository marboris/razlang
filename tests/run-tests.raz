use std.io;
use std.env;
use std.text;
use std.process;
use std.json;

function trimText(value: string) -> string {
    let begin: i64 = 0;
    let end: i64 = length(value);
    while (begin < end && (value[begin] == 32 || value[begin] == 9 || value[begin] == 10 || value[begin] == 13)) begin = begin + 1;
    while (end > begin && (value[end - 1] == 32 || value[end - 1] == 9 || value[end - 1] == 10 || value[end - 1] == 13)) end = end - 1;
    return slice(value, begin, end);
}

function configValue(contents: string, key: string) -> string {
    let prefix: string = key + "=";
    let cursor: i64 = 0;
    while (cursor < length(contents)) {
        let end: i64 = cursor;
        while (end < length(contents) && contents[end] != 10) end = end + 1;
        let line: string = trimText(slice(contents, cursor, end));
        if (length(line) >= length(prefix) && slice(line, 0, length(prefix)) == prefix) {
            let value: string = trimText(slice(line, length(prefix), length(line)));
            if (length(value) >= 2 && ((value[0] == 34 && value[length(value) - 1] == 34) || (value[0] == 39 && value[length(value) - 1] == 39))) value = slice(value, 1, length(value) - 1);
            return value;
        }
        cursor = end + 1;
    }
    return "";
}

function textContains(value: string, needle: string) -> bool {
    if (needle == "") return true;
    if (length(needle) > length(value)) return false;
    let cursor: i64 = 0;
    while (cursor + length(needle) <= length(value)) {
        if (slice(value, cursor, cursor + length(needle)) == needle) return true;
        cursor = cursor + 1;
    }
    return false;
}

function quoteArg(value: string) -> string {
    return "\"" + value + "\"";
}

function outputPath(sourcePath: string) -> string {
    if (length(sourcePath) < 4 || slice(sourcePath, length(sourcePath) - 4, length(sourcePath)) != ".raz") return sourcePath + ".cpp";
    return slice(sourcePath, 0, length(sourcePath) - 4) + ".cpp";
}

function runRuntimeCase(name: string, cppPath: string, expectedExitCode: string) -> bool {
    let configText: string = readFile("options");
    let nativeCompiler: string = getEnv("CXX");
    let nativeFlags: string = getEnv("CXXFLAGS");
    if (nativeCompiler == "") nativeCompiler = configValue(configText, "CXX");
    if (nativeCompiler == "") nativeCompiler = "g++";
    if (nativeFlags == "") nativeFlags = configValue(configText, "CXXFLAGS");

    let executablePath: string = slice(cppPath, 0, length(cppPath) - 4) + ".runtime";
    let discard: string = exec("rm -f " + quoteArg(executablePath));
    let buildCommand: string = quoteArg(nativeCompiler) + " -std=c++17 " + nativeFlags + " -I " + quoteArg("library/raz") + " -I " + quoteArg("tests") + " " + quoteArg(cppPath) + " -o " + quoteArg(executablePath);
    let buildOutput: string = exec buildCommand;
    let buildStatus: i64 = exitCode();
    if (buildStatus != 0) {
        print("FAIL " + name + ": GNU C++ compilation failed");
        if (buildOutput != "") print(buildOutput);
        let cleanup: string = exec("rm -f " + quoteArg(executablePath));
        return false;
    }

    let runOutput: string = exec(quoteArg("./" + executablePath));
    let runStatus: i64 = exitCode();
    let cleanup: string = exec("rm -f " + quoteArg(executablePath));
    if (int_to_string(runStatus) != expectedExitCode) {
        print("FAIL " + name + ": expected exit code " + expectedExitCode + ", got " + int_to_string(runStatus));
        if (runOutput != "") print(runOutput);
        return false;
    }
    print("PASS runtime " + name + " (exit code " + expectedExitCode + ")");
    return true;
}

function compileCase(name: string, relativeSource: string, compilerPath: string, expectedFailure: bool, expectedExitCode: string) -> bool {
    let sourcePath: string = "tests/" + relativeSource;
    let cppPath: string = outputPath(sourcePath);
    let discard: string = exec("rm -f " + quoteArg(cppPath));
    let command: string = quoteArg(compilerPath) + " " + quoteArg(sourcePath) + " --emit-cpp " + quoteArg(cppPath);
    let output: string = exec command;
    let status: i64 = exitCode();
    if (expectedFailure) {
        if (status != 0) {
            print("PASS expected-rejection " + name);
            return true;
        }
        print("FAIL " + name + ": source compiled but should be rejected");
        print(output);
        return false;
    }
    if (status != 0) {
        print("FAIL " + name + ": Raz compilation failed");
        if (output != "") print(output);
        return false;
    }
    if (readFile(cppPath) == "") {
        print("FAIL " + name + ": C++ output is missing or empty");
        return false;
    }
    print("CPP " + sourcePath + " -> " + cppPath);
    if (expectedExitCode != "") return runRuntimeCase(name, cppPath, expectedExitCode);
    return true;
}

function runTests() -> i64 {
    let configText: string = readFile("raz.env");
    let razc: string = getEnv("RAZC");
    let manifestPath: string = getEnv("RAZ_TEST_MANIFEST");
    if (razc == "") razc = configValue(configText, "RAZC");
    if (manifestPath == "") manifestPath = configValue(configText, "RAZ_TEST_MANIFEST");
    if (razc == "") razc = "./compiler/razc/bin/razc";
    if (manifestPath == "") manifestPath = "tests/manifest.json";

    let expectedVersion: string = trimText(readFile("VERSION"));
    let actualVersion: string = exec(quoteArg(razc) + " --version");
    if (exitCode() != 0 || expectedVersion == "" || !textContains(actualVersion, expectedVersion)) {
        print("test-runner: compiler version mismatch; expected " + expectedVersion + ", got " + trimText(actualVersion));
        return 2;
    }

    let manifestText: string = readFile(manifestPath);
    if (manifestText == "") {
        print("test-runner: cannot read " + manifestPath + "; run from project root");
        return 2;
    }
    let manifest: JsonDocument = jsonParse(manifestText);
    if (!manifest.valid) {
        print("test-runner: invalid manifest: " + manifest.error);
        return 2;
    }
    let casesId: i64 = jsonObjectGet(manifest, manifest.root, "cases");
    let negativeId: i64 = jsonObjectGet(manifest, manifest.root, "negative");
    if (jsonKind(manifest, casesId) != 4 || jsonKind(manifest, negativeId) != 4) {
        print("test-runner: manifest requires cases and negative arrays");
        return 2;
    }

    let passed: i64 = 0;
    let failed: i64 = 0;
    let caseIndex: i64 = 0;
    while (caseIndex < jsonArrayLength(manifest, casesId)) {
        let entry: i64 = jsonArrayAt(manifest, casesId, caseIndex);
        let name: string = jsonText(manifest, jsonObjectGet(manifest, entry, "name"));
        let source: string = jsonText(manifest, jsonObjectGet(manifest, entry, "source"));
        let runtimeNode: i64 = jsonObjectGet(manifest, entry, "runtime_exit_code");
        let expectedExitCode: string = "";
        if (jsonKind(manifest, runtimeNode) == 2) expectedExitCode = jsonText(manifest, runtimeNode);
        if (compileCase(name, source, razc, false, expectedExitCode)) passed = passed + 1;
        else failed = failed + 1;
        caseIndex = caseIndex + 1;
    }
    caseIndex = 0;
    while (caseIndex < jsonArrayLength(manifest, negativeId)) {
        let entry: i64 = jsonArrayAt(manifest, negativeId, caseIndex);
        let name: string = jsonText(manifest, jsonObjectGet(manifest, entry, "name"));
        let source: string = jsonText(manifest, jsonObjectGet(manifest, entry, "source"));
        if (compileCase(name, source, razc, true, "")) passed = passed + 1;
        else failed = failed + 1;
        caseIndex = caseIndex + 1;
    }

    print("Raz Gen2 tests: " + int_to_string(passed) + " passed, " + int_to_string(failed) + " failed");
    if (failed != 0) return 1;
    return 0;
}

return runTests();
